# Optional settings, set as environment variables. NOTE: the app does NOT read a .env file; this file only
# documents the names. In PowerShell, set them in the same window before running `streamlit run app.py`,
# for example:  $env:LABELGUARD_OCR_ENABLED = "false"
# None of these is required; the defaults work.

# Full path to tesseract.exe, only if Tesseract is installed but not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Turn OCR off entirely (scanned PDFs will then be flagged instead of read):
# LABELGUARD_OCR_ENABLED=false

# OCR language (Tesseract language code; the language data must be installed):
# LABELGUARD_OCR_LANG=eng

# Upload limits:
# LABELGUARD_MAX_UPLOAD_MB=25
# LABELGUARD_MAX_PAGES=20

# Where the SQLite run log is stored (default: data/labelguard.db):
# LABELGUARD_DB_PATH=

# Path to a different validation rules file (default: config/rules.toml):
# LABELGUARD_RULES_PATH=

# Change-impact rules (which labels a parameter change may affect; default: config/impact_rules.toml):
# LABELGUARD_IMPACT_RULES_PATH=

# --- Optional AI-assisted explanations (Claude API) ---
# The app works fully without these. Set the key as an ENVIRONMENT VARIABLE; never write it into code, a
# committed file or a screenshot. In PowerShell, for the current window only:
#     $env:ANTHROPIC_API_KEY = "your-key-here"
# AI mode sends finding text and evidence quotes to the Claude API only when you choose it and confirm it.
# ANTHROPIC_API_KEY=
# LABELGUARD_AI_ENABLED=true
# LABELGUARD_AI_MODEL=claude-sonnet-5-5
# LABELGUARD_AI_TIMEOUT_S=30
# LABELGUARD_AI_MAX_TOKENS=1500
